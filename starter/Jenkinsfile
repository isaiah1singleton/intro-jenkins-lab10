pipeline {
    agent any
    tools {
        maven 'Maven-3.9.16'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                sh 'cd starter && mvn -B clean package'
            }
        }
        stage('Test') {
            steps {
                sh 'cd starter && mvn -B test'
            }
            post {
                always {
                    junit 'starter/target/surefire-reports/*.xml'
                    jacoco execPattern: 'starter/target/jacoco.exec'
                }
            }
        }
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'starter/target/*.jar', fingerprint: true
            }
        }
    }
}
